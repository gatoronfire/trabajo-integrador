# Copiá este archivo como .env y completá los valores de tu proyecto de Supabase.
# Los encontrás en el panel de Supabase: Project Settings → API.

# URL del proyecto (Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública "anon" (Project API keys → anon public).
# Nunca pongas acá la clave service_role: todo lo que empieza con VITE_ queda visible en el navegador.
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
